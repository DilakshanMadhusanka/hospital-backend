  allocatedBy User  @relation("IPDBedAllocatedBy", fields: [allocatedById], references: [id])
  releasedBy  User? @relation("IPDBedReleasedBy", fields: [releasedById], references: [id])

  @@index([admissionId, releasedAt])
  @@index([bedId, releasedAt])
}

model IPDObservation {
  id          String @id @default(uuid())
  admissionId String

  type IPDObservationType @default(ROUTINE)

  temperature      Float?
  systolicBP       Int?
  diastolicBP      Int?
  pulseRate        Int?
  respiratoryRate  Int?
  oxygenSaturation Float?

  weightKg Float?
  notes    String?

  recordedById String
  recordedAt   DateTime @default(now())

  admission  IPDAdmission @relation(fields: [admissionId], references: [id])
