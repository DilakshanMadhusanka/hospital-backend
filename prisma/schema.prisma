  investigationName String
  clinicalReason    String?

  status      InvestigationStatus @default(REQUESTED)
  requestedAt DateTime            @default(now())

  visit  OPDVisit @relation(fields: [visitId], references: [id])
  doctor User     @relation("InvestigationDoctor", fields: [doctorId], references: [id])
  user   User?    @relation("InvestigationRequestUser", fields: [userId], references: [id])
  userId String?  @db.Uuid

  @@index([visitId])
  @@index([status])
}

model IPDAdmission {
  id              String @id @default(uuid())
  admissionNumber String @unique

  patientId    String
  hospitalId   String
  departmentId String

  admittedById      String
  attendingDoctorId String?

  admissionDate DateTime  @default(now())
  dischargeDate DateTime?

  status IPDAdmissionStatus @default(ADMITTED)

  admissionReason    String
  admissionDiagnosis String?
  clinicalNotes      String?

  dischargeSummary      String?
  dischargeInstructions String?
  dischargeRemarks      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient    Patient    @relation(fields: [patientId], references: [id])
  hospital   Hospital   @relation(fields: [hospitalId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  admittedBy      User  @relation("IPDAdmittedBy", fields: [admittedById], references: [id])
  attendingDoctor User? @relation("IPDAttendingDoctor", fields: [attendingDoctorId], references: [id])

  bedAllocations       IPDBedAllocation[]
  observations         IPDObservation[]
  nursingNotes         IPDNursingNote[]
  labRequests          LabRequest[]
  radiologyRequests    RadiologyRequest[]
  transfers            IPDTransfer[]
  dischargeRequests    IPDDischargeRequest[]
