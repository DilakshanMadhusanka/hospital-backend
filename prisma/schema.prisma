  admissionId String

  note         String
  careProvided String?
  recordedById String
  recordedAt   DateTime @default(now())

  admission  IPDAdmission @relation(fields: [admissionId], references: [id])
  recordedBy User         @relation("IPDNursingNoteRecordedBy", fields: [recordedById], references: [id])

  @@index([admissionId, recordedAt])
}

model LabTest {
  id         String @id @default(uuid())
  hospitalId String

  code           String
  name           String
  description    String?
  specimenType   String
  unit           String?
  referenceRange String?
  price          Decimal? @db.Decimal(10, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hospital     Hospital         @relation(fields: [hospitalId], references: [id])
  requestItems LabRequestItem[]

  @@unique([hospitalId, code])
  @@index([hospitalId, isActive])
}

model LabRequest {
  id            String @id @default(uuid())
  requestNumber String @unique

  patientId    String
  hospitalId   String
  departmentId String

  opdVisitId     String?
  ipdAdmissionId String?

  requestedById String

  priority LabPriority      @default(ROUTINE)
  status   LabRequestStatus @default(REQUESTED)

  clinicalNotes String?
  requestedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patient    Patient    @relation(fields: [patientId], references: [id])
  hospital   Hospital   @relation(fields: [hospitalId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  opdVisit     OPDVisit?     @relation(fields: [opdVisitId], references: [id])
  ipdAdmission IPDAdmission? @relation(fields: [ipdAdmissionId], references: [id])

  requestedBy User @relation("LabRequestDoctor", fields: [requestedById], references: [id])

  items                LabRequestItem[]
  user                 User?               @relation(fields: [userId], references: [id])
  userId               String?             @db.Uuid
  emergencyEncounter   EmergencyEncounter? @relation(fields: [emergencyEncounterId], references: [id], onDelete: Restrict)
  emergencyEncounterId String?             @db.Uuid

  @@index([hospitalId, status, requestedAt])
  @@index([patientId, requestedAt])
  @@index([opdVisitId])
  @@index([ipdAdmissionId])
  @@index([emergencyEncounterId])
}

model LabRequestItem {
  id String @id @default(uuid())

  requestId String
  testId    String

  status LabRequestItemStatus @default(REQUESTED)

  sample LabSample?
  result LabResult?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request LabRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  test    LabTest    @relation(fields: [testId], references: [id])

  @@index([requestId, status])
  @@index([testId])
}

model LabSample {
  id           String @id @default(uuid())
  sampleNumber String @unique

  requestItemId String @unique

  specimenType String
  status       LabSampleStatus @default(COLLECTED)

  collectedById String
  collectedAt   DateTime @default(now())

  receivedAt      DateTime?
  rejectionReason String?

  requestItem LabRequestItem @relation(fields: [requestItemId], references: [id])
  collectedBy User           @relation("LabSampleCollectedBy", fields: [collectedById], references: [id])
  user        User?          @relation(fields: [userId], references: [id])
  userId      String?        @db.Uuid

  @@index([status, collectedAt])
}

model LabResult {
  id            String @id @default(uuid())
  requestItemId String @unique

  resultValue    String
  unit           String?
  referenceRange String?
  interpretation String?
  remarks        String?

  status LabResultStatus @default(DRAFT)

  enteredById  String
  verifiedById String?

  enteredAt  DateTime  @default(now())
  verifiedAt DateTime?

  requestItem LabRequestItem @relation(fields: [requestItemId], references: [id])

  enteredBy  User    @relation("LabResultEnteredBy", fields: [enteredById], references: [id])
  verifiedBy User?   @relation("LabResultVerifiedBy", fields: [verifiedById], references: [id])
  user       User?   @relation(fields: [userId], references: [id])
  userId     String? @db.Uuid

  @@index([status, enteredAt])
}

model Medicine {
  id         String @id @default(uuid())
  hospitalId String

  code         String
  name         String
  genericName  String?
  brandName    String?
  strength     String?
  dosageForm   String?
  unit         String
  reorderLevel Int     @default(10)

  status MedicineStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hospital          Hospital               @relation(fields: [hospitalId], references: [id])
  batches           MedicineBatch[]
  purchaseItems     PurchaseOrderItem[]
  dispenseItems     PharmacyDispenseItem[]
  stockMovements    StockMovement[]
  department        Department?            @relation(fields: [departmentId], references: [id])
  departmentId      String?                @db.Uuid
  prescriptionItems PrescriptionItem[]

  @@unique([hospitalId, code])
  @@index([hospitalId, status])
  @@index([hospitalId, name])
}

model Supplier {
  id         String @id @default(uuid())
  hospitalId String

  code          String
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hospital       Hospital        @relation(fields: [hospitalId], references: [id])
  purchaseOrders PurchaseOrder[]
  department     Department?     @relation(fields: [departmentId], references: [id])
  departmentId   String?         @db.Uuid

  @@unique([hospitalId, code])
  @@index([hospitalId, isActive])
}

model PurchaseOrder {
  id          String @id @default(uuid())
  orderNumber String @unique

  hospitalId String
  supplierId String

  status       PurchaseOrderStatus @default(DRAFT)
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  notes        String?

  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hospital  Hospital @relation(fields: [hospitalId], references: [id])
  supplier  Supplier @relation(fields: [supplierId], references: [id])
  createdBy User     @relation("PharmacyPurchaseOrderCreator", fields: [createdById], references: [id])

  items        PurchaseOrderItem[]
  department   Department?         @relation(fields: [departmentId], references: [id])
  departmentId String?             @db.Uuid
  user         User?               @relation(fields: [userId], references: [id])
  userId       String?             @db.Uuid

  @@index([hospitalId, status])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id              String @id @default(uuid())
  purchaseOrderId String
  medicineId      String

  orderedQuantity  Int
  receivedQuantity Int     @default(0)
  unitCost         Decimal @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  medicine      Medicine      @relation(fields: [medicineId], references: [id])

  @@unique([purchaseOrderId, medicineId])
}

model MedicineBatch {
  id         String @id @default(uuid())
  hospitalId String
  medicineId String

  batchNumber String
  expiryDate  DateTime @db.Date

  quantity Int     @default(0)
  unitCost Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medicine       Medicine               @relation(fields: [medicineId], references: [id])
  stockMovements StockMovement[]
  dispenseItems  PharmacyDispenseItem[]
  department     Department?            @relation(fields: [departmentId], references: [id])
  departmentId   String?                @db.Uuid
  hospital       Hospital               @relation(fields: [hospitalId], references: [id])

  @@unique([hospitalId, medicineId, batchNumber])
  @@index([hospitalId, expiryDate])
  @@index([medicineId, expiryDate])
}

model StockMovement {
  id         String  @id @default(uuid())
  hospitalId String
  medicineId String
  batchId    String?

  type         StockMovementType
  quantity     Int
  balanceAfter Int

  reference String?
  reason    String?

  performedById String
  createdAt     DateTime @default(now())

  medicine     Medicine       @relation(fields: [medicineId], references: [id])
  batch        MedicineBatch? @relation(fields: [batchId], references: [id])
  performedBy  User           @relation("PharmacyStockMovementUser", fields: [performedById], references: [id])
  department   Department?    @relation(fields: [departmentId], references: [id])
  departmentId String?        @db.Uuid
  user         User?          @relation(fields: [userId], references: [id])
  userId       String?        @db.Uuid
  hospital     Hospital       @relation(fields: [hospitalId], references: [id])

  @@index([hospitalId, medicineId, createdAt])
  @@index([batchId, createdAt])
}

model PharmacyDispense {
  id             String @id @default(uuid())
  dispenseNumber String @unique

  hospitalId     String
  prescriptionId String

  dispensedById String
  status        PharmacyDispenseStatus @default(COMPLETED)

  notes       String?
  dispensedAt DateTime @default(now())

  items PharmacyDispenseItem[]

  dispensedBy  User        @relation("PharmacyDispenseUser", fields: [dispensedById], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?     @db.Uuid
  user         User?       @relation(fields: [userId], references: [id])
  userId       String?     @db.Uuid
  hospital     Hospital    @relation(fields: [hospitalId], references: [id])

  @@index([hospitalId, dispensedAt])
  @@index([prescriptionId])
}

model PharmacyDispenseItem {
  id                 String @id @default(uuid())
  dispenseId         String
  prescriptionItemId String
  medicineId         String
  batchId            String

  quantity Int

  dispense         PharmacyDispense @relation(fields: [dispenseId], references: [id], onDelete: Cascade)
  prescriptionItem PrescriptionItem @relation(fields: [prescriptionItemId], references: [id])
  medicine         Medicine         @relation(fields: [medicineId], references: [id])
  batch            MedicineBatch    @relation(fields: [batchId], references: [id])

  @@index([prescriptionItemId])
  @@index([batchId])
}

model RadiologyProcedure {
  id           String  @id @default(uuid()) @db.Uuid
  hospitalId   String  @db.Uuid
  departmentId String? @db.Uuid

  code        String
  name        String
  modality    ImagingModality
  description String?

  preparationInstructions  String?
  estimatedDurationMinutes Int     @default(15)

  status RadiologyProcedureStatus @default(ACTIVE)

  hospital   Hospital    @relation(fields: [hospitalId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  requests RadiologyRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, code])
  @@index([hospitalId, modality, status])
  @@index([departmentId])
  @@map("radiology_procedures")
}

model ImagingEquipment {
  id           String  @id @default(uuid()) @db.Uuid
  hospitalId   String  @db.Uuid
  departmentId String? @db.Uuid

  assetCode    String
  name         String
  modality     ImagingModality
  manufacturer String?
  modelNumber  String?
  serialNumber String?

  location String?

  status ImagingEquipmentStatus @default(OPERATIONAL)

  lastMaintenanceAt DateTime?
  nextMaintenanceAt DateTime?

  hospital   Hospital    @relation(fields: [hospitalId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  appointments RadiologyAppointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, assetCode])
  @@index([hospitalId, modality, status])
  @@index([departmentId])
  @@map("imaging_equipment")
}

model RadiologyRequest {
  id String @id @default(uuid()) @db.Uuid

  requestNumber String

  hospitalId   String @db.Uuid
  departmentId String @db.Uuid
  patientId    String @db.Uuid
  procedureId  String @db.Uuid

  // A request must originate from an OPD visit or an IPD admission.
  // The service will enforce that exactly one is supplied.
  opdVisitId     String?
  ipdAdmissionId String?

  requestedById String @db.Uuid

  clinicalIndication String
  priority           RadiologyPriority      @default(ROUTINE)
  status             RadiologyRequestStatus @default(REQUESTED)
  notes              String?

  requestedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hospital    Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  department  Department         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  patient     Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  procedure   RadiologyProcedure @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  requestedBy User               @relation(fields: [requestedById], references: [id], onDelete: Restrict)

  opdVisit     OPDVisit?     @relation(fields: [opdVisitId], references: [id], onDelete: Restrict)
  ipdAdmission IPDAdmission? @relation(fields: [ipdAdmissionId], references: [id], onDelete: Restrict)

  appointments RadiologyAppointment[]

  createdAt            DateTime            @default(now())
  emergencyEncounter   EmergencyEncounter? @relation(fields: [emergencyEncounterId], references: [id], onDelete: Restrict)
  emergencyEncounterId String?             @db.Uuid

  @@unique([hospitalId, requestNumber])
  @@index([hospitalId, status, requestedAt])
  @@index([hospitalId, patientId])
  @@index([hospitalId, departmentId, requestedAt])
  @@index([procedureId, status])
  @@index([opdVisitId])
  @@index([ipdAdmissionId])
  @@index([emergencyEncounterId])
  @@map("radiology_requests")
}

model RadiologyAppointment {
  id String @id @default(uuid()) @db.Uuid

  hospitalId  String @db.Uuid
  requestId   String @db.Uuid
  equipmentId String @db.Uuid
  createdById String @db.Uuid

  scheduledStart DateTime
  scheduledEnd   DateTime

  status RadiologyAppointmentStatus @default(SCHEDULED)

  notes String?

  arrivedAt   DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  reports RadiologyReport[]

  hospital  Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  request   RadiologyRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  equipment ImagingEquipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  createdBy User             @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hospitalId, scheduledStart])
  @@index([equipmentId, scheduledStart, scheduledEnd])
  @@index([requestId, status])
  @@index([status, scheduledStart])
  @@map("radiology_appointments")
}

model RadiologyReport {
  id String @id @default(uuid()) @db.Uuid

  hospitalId    String @db.Uuid
  appointmentId String @db.Uuid

  version Int @default(1)

  technique       String?
  clinicalHistory String?
  findings        String
  impression      String
  recommendations String?

  status RadiologyReportStatus @default(DRAFT)

  radiologistId String  @db.Uuid
  verifiedById  String? @db.Uuid

  verifiedAt DateTime?
  amendedAt  DateTime?

  // Links a new version to the report it supersedes.
  previousReportId String? @db.Uuid

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  appointment RadiologyAppointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  radiologist User @relation("RadiologyReportAuthor", fields: [radiologistId], references: [id], onDelete: Restrict)

  verifiedBy User? @relation("RadiologyReportVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)

  previousReport RadiologyReport? @relation("RadiologyReportVersions", fields: [previousReportId], references: [id], onDelete: Restrict)

  nextVersions RadiologyReport[] @relation("RadiologyReportVersions")

  images RadiologyImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appointmentId, version])
  @@index([hospitalId, status, createdAt])
  @@index([radiologistId, createdAt])
  @@index([appointmentId])
  @@index([previousReportId])
  @@map("radiology_reports")
}

model RadiologyImage {
  id String @id @default(uuid()) @db.Uuid

  hospitalId String @db.Uuid
  reportId   String @db.Uuid

  fileName   String
  storageKey String
  mimeType   String
  fileSize   BigInt

  checksum String?

  description String?

  uploadedById String @db.Uuid

  report RadiologyReport @relation(fields: [reportId], references: [id], onDelete: Restrict)

  uploadedBy User @relation("RadiologyImageUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([hospitalId, reportId])
  @@index([uploadedById, createdAt])
  @@map("radiology_images")
}

model IPDTransfer {
  id String @id @default(uuid()) @db.Uuid

  // IPDAdmission.id is String without @db.Uuid
  // in the existing schema, so this field must match it.
  admissionId String

  // Keep this scalar consistent with the existing
  // IPDAdmission.hospitalId type.
  hospitalId String

  fromWardId String @db.Uuid
  toWardId   String @db.Uuid

  fromBedId String @db.Uuid
  toBedId   String @db.Uuid

  reason        String
  clinicalNotes String?

  status IPDTransferStatus @default(REQUESTED)

  requestedById String  @db.Uuid
  approvedById  String? @db.Uuid
  completedById String? @db.Uuid

  rejectionReason String?

  requestedAt DateTime  @default(now())
  approvedAt  DateTime?
  completedAt DateTime?
  rejectedAt  DateTime?
  cancelledAt DateTime?

  admission IPDAdmission @relation(fields: [admissionId], references: [id], onDelete: Restrict)

  fromWard Ward @relation("IPDTransferFromWard", fields: [fromWardId], references: [id], onDelete: Restrict)
  toWard   Ward @relation("IPDTransferToWard", fields: [toWardId], references: [id], onDelete: Restrict)

  fromBed Bed @relation("IPDTransferFromBed", fields: [fromBedId], references: [id], onDelete: Restrict)
  toBed   Bed @relation("IPDTransferToBed", fields: [toBedId], references: [id], onDelete: Restrict)

  requestedBy User  @relation("IPDTransferRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy  User? @relation("IPDTransferApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  completedBy User? @relation("IPDTransferCompleter", fields: [completedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ward      Ward?    @relation("IPDTransferWard", fields: [wardId], references: [id])
  wardId    String?  @db.Uuid
  bed       Bed?     @relation("IPDTransferBed", fields: [bedId], references: [id])
  bedId     String?  @db.Uuid
  user      User?    @relation("IPDTransferUser", fields: [userId], references: [id])
  userId    String?  @db.Uuid

  @@index([hospitalId, status, requestedAt])
  @@index([admissionId, requestedAt])
  @@index([fromWardId])
  @@index([toWardId])
  @@index([requestedById, requestedAt])
  @@map("ipd_transfers")
}

model IPDDischargeRequest {
  id String @id @default(uuid()) @db.Uuid

  // Match the existing IPDAdmission scalar types.
  admissionId String
  hospitalId  String

  reason        String
  clinicalNotes String?

  status IPDDischargeStatus @default(REQUESTED)

  requestedById String  @db.Uuid
  reviewedById  String? @db.Uuid

  rejectionReason String?

  requestedAt DateTime  @default(now())
  reviewedAt  DateTime?
  cancelledAt DateTime?

  admission IPDAdmission @relation(fields: [admissionId], references: [id], onDelete: Restrict)

  requestedBy User  @relation("IPDDischargeRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy  User? @relation("IPDDischargeReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  summary IPDDischargeSummary?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hospitalId, status, requestedAt])
  @@index([admissionId, requestedAt])
  @@index([requestedById])
  @@map("ipd_discharge_requests")
}

model IPDDischargeSummary {
  id String @id @default(uuid()) @db.Uuid

  dischargeRequestId String @unique @db.Uuid
  hospitalId         String

  finalDiagnosis      String
  secondaryDiagnoses  String?
  treatmentProvided   String
  proceduresPerformed String?

  conditionAtDischarge   String
  dischargeMedications   String
  medicationInstructions String?
  followUpInstructions   String
  followUpDate           DateTime?
  warningSigns           String?

  preparedById String   @db.Uuid
  preparedAt   DateTime @default(now())

