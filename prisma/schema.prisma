// ======================================================
// GENERATOR & DATABASE
// ======================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// ENUMS
// ======================================================

enum HospitalType {
  NATIONAL
  TEACHING
  PROVINCIAL_GENERAL
  DISTRICT_GENERAL
  BASE
  DIVISIONAL
  PRIMARY_MEDICAL_CARE_UNIT
  OTHER
}

enum HospitalStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum WardType {
  GENERAL
  MEDICAL
  SURGICAL
  PEDIATRIC
  MATERNITY
  ICU
  EMERGENCY
  OTHER
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
  OUT_OF_SERVICE
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LOCKED
}

enum PatientSex {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

enum PatientRegistrationStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
}

enum ContactType {
  MOBILE
  HOME
  WORK
  OTHER
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  UNKNOWN
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ACCESS
  EXPORT
}

// ======================================================
// 1. HOSPITAL ORGANIZATION
// ======================================================

model Hospital {
  id     String         @id @default(uuid()) @db.Uuid
  code   String         @unique
  name   String
  type   HospitalType
  status HospitalStatus @default(ACTIVE)

  address  String
  district String
  province String

  phone String?
  email String?

  departments      Department[]
  wards            Ward[]
  beds             Bed[]
  services         HospitalService[]
  staffAssignments HospitalStaffAssignment[]
  registrations    HospitalPatient[]
  userRoles        UserRole[]
  auditLogs        AuditLog[]
  settings         SystemSetting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([district])
  @@index([type, status])
  @@map("hospitals")
}

model Department {
  id         String @id @default(uuid()) @db.Uuid
  hospitalId String @db.Uuid

  code        String
  name        String
  description String?
  status      DepartmentStatus @default(ACTIVE)

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  wards            Ward[]
  services         HospitalService[]
  staffAssignments HospitalStaffAssignment[]
  userRoles        UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, code])
  @@index([hospitalId, status])
  @@map("departments")
}

model Ward {
  id           String @id @default(uuid()) @db.Uuid
  hospitalId   String @db.Uuid
  departmentId String @db.Uuid

  code        String
  name        String
  type        WardType
  description String?

  hospital   Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id])

  beds Bed[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, code])
  @@index([departmentId])
  @@map("wards")
}

model Bed {
  id         String @id @default(uuid()) @db.Uuid
  hospitalId String @db.Uuid
  wardId     String @db.Uuid

  bedNumber String
  status    BedStatus @default(AVAILABLE)

  description String?

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  ward     Ward     @relation(fields: [wardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([wardId, bedNumber])
  @@index([hospitalId, status])
  @@map("beds")
}

model HospitalService {
  id           String  @id @default(uuid()) @db.Uuid
  hospitalId   String  @db.Uuid
  departmentId String? @db.Uuid

  code        String
  name        String
  description String?
  status      ServiceStatus @default(ACTIVE)

  hospital   Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, code])
  @@index([hospitalId, status])
  @@map("hospital_services")
}

// ======================================================
// 2. AUTHENTICATION & ACCESS CONTROL
// ======================================================

model User {
  id String @id @default(uuid()) @db.Uuid

  username     String @unique
  email        String @unique
  passwordHash String

  firstName String
  lastName  String
  phone     String?
  isActive  Boolean @default(true)

  status      UserStatus @default(ACTIVE)
  lastLoginAt DateTime?

  roles                    UserRole[]
  staffAssignments         HospitalStaffAssignment[]
  medicalHistoriesRecorded PatientMedicalHistory[]   @relation("MedicalHistoryRecorder")
  allergiesRecorded        PatientAllergy[]          @relation("AllergyRecorder")
  auditLogs                AuditLog[]
  settingsUpdated          SystemSetting[]           @relation("SettingUpdater")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([lastName, firstName])
  @@map("users")
}

model Role {
  id String @id @default(uuid()) @db.Uuid

  name        String  @unique
  description String?
  isSystem    Boolean @default(false)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id String @id @default(uuid()) @db.Uuid

  code        String  @unique
  name        String
  description String?

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model UserRole {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  roleId String @db.Uuid

  // Role can be limited to a particular hospital/department.
  hospitalId   String? @db.Uuid
  departmentId String? @db.Uuid

  assignedAt DateTime  @default(now())
  expiresAt  DateTime?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  hospital   Hospital?   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([roleId])
  @@index([hospitalId, departmentId])
  @@map("user_roles")
}

model RolePermission {
  id String @id @default(uuid()) @db.Uuid

  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ======================================================
// 3. HOSPITAL STAFF ASSIGNMENTS
// ======================================================

model HospitalStaffAssignment {
  id String @id @default(uuid()) @db.Uuid

  userId       String  @db.Uuid
  hospitalId   String  @db.Uuid
  departmentId String? @db.Uuid

  employeeNumber String?
  jobTitle       String

  startDate DateTime
  endDate   DateTime?
  isPrimary Boolean   @default(false)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital   Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, employeeNumber])
  @@index([userId, hospitalId])
  @@index([departmentId])
  @@map("hospital_staff_assignments")
}

// ======================================================
// 4. PATIENT MANAGEMENT
// ======================================================

model Patient {
  id String @id @default(uuid()) @db.Uuid

  firstName  String
  middleName String?
  lastName   String

  dateOfBirth DateTime?
  sex         PatientSex @default(UNKNOWN)

  nationalId String?
  bloodGroup BloodGroup @default(UNKNOWN)

  registrations  HospitalPatient[]
  addresses      PatientAddress[]
  contacts       PatientContact[]
  medicalHistory PatientMedicalHistory[]
  allergies      PatientAllergy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nationalId])
  @@index([lastName, firstName])
  @@index([dateOfBirth])
  @@map("patients")
}

model HospitalPatient {
  id String @id @default(uuid()) @db.Uuid

  patientId  String @db.Uuid
  hospitalId String @db.Uuid

  hospitalPatientNumber String
  registrationStatus    PatientRegistrationStatus @default(ACTIVE)

  registeredAt DateTime @default(now())

  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, hospitalPatientNumber])
  @@unique([patientId, hospitalId])
  @@index([patientId])
  @@index([hospitalId, registrationStatus])
  @@map("hospital_patients")
}

model PatientAddress {
  id String @id @default(uuid()) @db.Uuid

  patientId String @db.Uuid

  addressLine1 String
  addressLine2 String?
  city         String?
  district     String?
  province     String?
  postalCode   String?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@map("patient_addresses")
}

model PatientContact {
  id String @id @default(uuid()) @db.Uuid

  patientId String @db.Uuid

  type      ContactType
  value     String
  isPrimary Boolean     @default(false)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@map("patient_contacts")
}

model PatientMedicalHistory {
  id String @id @default(uuid()) @db.Uuid

  patientId        String  @db.Uuid
  recordedByUserId String? @db.Uuid

  condition   String
  description String?
  diagnosedAt DateTime?
  notes       String?

  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedBy User?   @relation("MedicalHistoryRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@map("patient_medical_history")
}

model PatientAllergy {
  id String @id @default(uuid()) @db.Uuid

  patientId        String  @db.Uuid
  recordedByUserId String? @db.Uuid

  substance String
  reaction  String?
  severity  AllergySeverity @default(UNKNOWN)
  isActive  Boolean         @default(true)
  notes     String?

  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedBy User?   @relation("AllergyRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, isActive])
  @@map("patient_allergies")
}

// ======================================================
// 5. SYSTEM ADMINISTRATION & AUDITING
// ======================================================

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  hospitalId  String? @db.Uuid
  actorUserId String? @db.Uuid

  action     AuditAction
  entityType String
  entityId   String?

  oldValues Json?
  newValues Json?

  ipAddress String?
  userAgent String?

  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  actor    User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([hospitalId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model SystemSetting {
  id String @id @default(uuid()) @db.Uuid

  hospitalId      String  @db.Uuid
  updatedByUserId String? @db.Uuid

  key         String
  value       Json
  description String?

  hospital  Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  updatedBy User?    @relation("SettingUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, key])
  @@map("system_settings")
}
