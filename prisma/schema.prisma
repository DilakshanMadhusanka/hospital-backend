  dischargedById String?   @db.Uuid
  dischargedBy   User?     @relation("IPDAdmissionDischargedBy", fields: [dischargedById], references: [id], onDelete: Restrict)

  @@index([hospitalId, status])
  @@index([patientId])
  @@index([departmentId, admissionDate])
  @@index([attendingDoctorId])
}

model IPDBedAllocation {
  id String @id @default(uuid())

  admissionId String
  bedId       String

  allocatedById String
  releasedById  String?

  allocatedAt DateTime  @default(now())
  releasedAt  DateTime?

