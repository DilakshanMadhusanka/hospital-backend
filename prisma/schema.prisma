// ======================================================
// GENERATOR & DATABASE
// ======================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// ENUMS
// ======================================================

enum MedicineStatus {
  ACTIVE
  INACTIVE
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum StockMovementType {
  PURCHASE
  DISPENSE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  EXPIRED
  RETURN
}

enum PharmacyDispenseStatus {
  COMPLETED
  CANCELLED
}

enum LabRequestStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  PARTIALLY_COMPLETED
  COMPLETED
  CANCELLED
}

enum LabRequestItemStatus {
  REQUESTED
  SAMPLE_COLLECTED
  PROCESSING
  RESULT_ENTERED
  VERIFIED
  REJECTED
  CANCELLED
}

enum LabSampleStatus {
  COLLECTED
  RECEIVED
  REJECTED
  PROCESSED
}

enum LabResultStatus {
  DRAFT
  VERIFIED
  REJECTED
}

enum LabPriority {
  ROUTINE
  URGENT
  STAT
}

enum IPDAdmissionStatus {
  ADMITTED
  DISCHARGED
  CANCELLED
}

enum IPDObservationType {
  ROUTINE
  DOCTOR_REVIEW
  EMERGENCY
}

enum OPDVisitStatus {
  REGISTERED
  WAITING
  CALLED
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ConsultationStatus {
  IN_PROGRESS
  COMPLETED
}

enum InvestigationStatus {
  REQUESTED
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PrescriptionStatus {
  ACTIVE
  DISPENSED
  PARTIALLY_DISPENSED
  CANCELLED
}

enum HospitalType {
  NATIONAL
  TEACHING
  PROVINCIAL_GENERAL
  DISTRICT_GENERAL
  BASE
  DIVISIONAL
  PRIMARY_MEDICAL_CARE_UNIT
  OTHER
}

enum HospitalStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum WardType {
  GENERAL
  MEDICAL
  SURGICAL
  PEDIATRIC
  MATERNITY
  ICU
  EMERGENCY
  OTHER
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
  OUT_OF_SERVICE
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LOCKED
}

enum PatientSex {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

enum PatientRegistrationStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
}

enum ContactType {
  MOBILE
  HOME
  WORK
  OTHER
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  UNKNOWN
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ACCESS
  EXPORT
}

// ======================================================
// 1. HOSPITAL ORGANIZATION
// ======================================================

model Hospital {
  id     String         @id @default(uuid()) @db.Uuid
  code   String         @unique
  name   String
  type   HospitalType
  status HospitalStatus @default(ACTIVE)

  address  String
  district String
  province String

  phone String?
  email String?

  departments      Department[]
  wards            Ward[]
  beds             Bed[]
  services         HospitalService[]
  staffAssignments HospitalStaffAssignment[]
  registrations    HospitalPatient[]
  userRoles        UserRole[]
  auditLogs        AuditLog[]
  settings         SystemSetting[]
  opdVisits        OPDVisit[]
  opdTokenCounters OPDTokenCounter[]
  doctorSchedules  DoctorSchedule[]
  ipdAdmissions    IPDAdmission[]
  labTests         LabTest[]
  labRequests      LabRequest[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  medicines         Medicine[]
  suppliers         Supplier[]
  purchaseOrders    PurchaseOrder[]
  medicineBatches   MedicineBatch[]
  stockMovements    StockMovement[]
  pharmacyDispenses PharmacyDispense[]

  @@index([district])
  @@index([type, status])
  @@map("hospitals")
}

model Department {
  id         String @id @default(uuid()) @db.Uuid
  hospitalId String @db.Uuid

  code        String
  name        String
  description String?
  status      DepartmentStatus @default(ACTIVE)

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  wards             Ward[]
  services          HospitalService[]
  staffAssignments  HospitalStaffAssignment[]
  userRoles         UserRole[]
  opdTokenCounters  OPDTokenCounter[]
  ipdAdmissions     IPDAdmission[]
  medicines         Medicine[]
  suppliers         Supplier[]
  purchaseOrders    PurchaseOrder[]
  medicineBatches   MedicineBatch[]
  stockMovements    StockMovement[]
  pharmacyDispenses PharmacyDispense[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  opdvisits       OPDVisit[]
  doctorSchedules DoctorSchedule[]
  labRequests     LabRequest[]

  @@unique([hospitalId, code])
  @@index([hospitalId, status])
  @@map("departments")
}

model Ward {
  id           String @id @default(uuid()) @db.Uuid
  hospitalId   String @db.Uuid
  departmentId String @db.Uuid

  code        String
  name        String
  type        WardType
  description String?

  hospital   Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id])

  beds Bed[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, code])
  @@index([departmentId])
  @@map("wards")
}

model Bed {
  id         String @id @default(uuid()) @db.Uuid
  hospitalId String @db.Uuid
  wardId     String @db.Uuid

  bedNumber String
  status    BedStatus @default(AVAILABLE)

  description String?

  ipdAllocations IPDBedAllocation[]

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  ward     Ward     @relation(fields: [wardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([wardId, bedNumber])
  @@index([hospitalId, status])
  @@map("beds")
}

model HospitalService {
  id           String  @id @default(uuid()) @db.Uuid
  hospitalId   String  @db.Uuid
  departmentId String? @db.Uuid

  code        String
  name        String
  description String?
  status      ServiceStatus @default(ACTIVE)

  hospital   Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, code])
  @@index([hospitalId, status])
  @@map("hospital_services")
}

// ======================================================
// 2. AUTHENTICATION & ACCESS CONTROL
// ======================================================

model User {
  id String @id @default(uuid()) @db.Uuid

  username     String @unique
  email        String @unique
  passwordHash String

  firstName String
  lastName  String
  phone     String?
  isActive  Boolean @default(true)

  status      UserStatus @default(ACTIVE)
  lastLoginAt DateTime?

  roles                    UserRole[]
  staffAssignments         HospitalStaffAssignment[]
  medicalHistoriesRecorded PatientMedicalHistory[]   @relation("MedicalHistoryRecorder")
  allergiesRecorded        PatientAllergy[]          @relation("AllergyRecorder")
  auditLogs                AuditLog[]
  settingsUpdated          SystemSetting[]           @relation("SettingUpdater")

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  opdvisits             OPDVisit[]
  opdDoctorVisits       OPDVisit[]             @relation("OPDDoctor")
  doctorSchedules       DoctorSchedule[]       @relation("DoctorSchedules")
  consultations         Consultation[]         @relation("ConsultationDoctor")
  prescriptions         Prescription[]         @relation("PrescriptionDoctor")
  investigationRequests InvestigationRequest[] @relation("InvestigationDoctor")
  scheduleEntries       DoctorSchedule[]       @relation("DoctorScheduleUser")
  consultationEntries   Consultation[]         @relation("ConsultationUser")
  prescriptionEntries   Prescription[]         @relation("PrescriptionUser")
  investigationEntries  InvestigationRequest[] @relation("InvestigationRequestUser")
  ipdAdmissionsCreated  IPDAdmission[]         @relation("IPDAdmittedBy")
  ipdAdmissionsAsDoctor IPDAdmission[]         @relation("IPDAttendingDoctor")

  ipdBedAllocationsCreated  IPDBedAllocation[] @relation("IPDBedAllocatedBy")
  ipdBedAllocationsReleased IPDBedAllocation[] @relation("IPDBedReleasedBy")

  ipdObservationsRecorded IPDObservation[] @relation("IPDObservationRecordedBy")
  ipdNursingNotesRecorded IPDNursingNote[] @relation("IPDNursingNoteRecordedBy")
  labRequests             LabRequest[]
  labSamples              LabSample[]
  labResults              LabResult[]

  labRequestsCreated LabRequest[] @relation("LabRequestDoctor")

  labSamplesCollected LabSample[] @relation("LabSampleCollectedBy")

  labResultsEntered  LabResult[] @relation("LabResultEnteredBy")
  labResultsVerified LabResult[] @relation("LabResultVerifiedBy")

  pharmacyPurchaseOrdersCreated PurchaseOrder[]    @relation("PharmacyPurchaseOrderCreator")
  pharmacyStockMovements        StockMovement[]    @relation("PharmacyStockMovementUser")
  pharmacyDispensesCreated      PharmacyDispense[] @relation("PharmacyDispenseUser")
  purchaseOrders                PurchaseOrder[]
  stockMovements                StockMovement[]
  pharmacyDispenses             PharmacyDispense[]

  @@index([status])
  @@index([lastName, firstName])
  @@map("users")
}

model Role {
  id String @id @default(uuid()) @db.Uuid

  name        String  @unique
  description String?
  isSystem    Boolean @default(false)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id String @id @default(uuid()) @db.Uuid

  code        String  @unique
  name        String
  description String?

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model UserRole {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  roleId String @db.Uuid

  // Role can be limited to a particular hospital/department.
  hospitalId   String? @db.Uuid
  departmentId String? @db.Uuid

  assignedAt DateTime  @default(now())
  expiresAt  DateTime?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  hospital   Hospital?   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([roleId])
  @@index([hospitalId, departmentId])
  @@map("user_roles")
}

model RolePermission {
  id String @id @default(uuid()) @db.Uuid

  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ======================================================
// 3. HOSPITAL STAFF ASSIGNMENTS
// ======================================================

model HospitalStaffAssignment {
  id String @id @default(uuid()) @db.Uuid

  userId       String  @db.Uuid
  hospitalId   String  @db.Uuid
  departmentId String? @db.Uuid

  employeeNumber String?
  jobTitle       String

  startDate DateTime
  endDate   DateTime?
  isPrimary Boolean   @default(false)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital   Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, employeeNumber])
  @@index([userId, hospitalId])
  @@index([departmentId])
  @@map("hospital_staff_assignments")
}

// ======================================================
// 4. PATIENT MANAGEMENT
// ======================================================

model Patient {
  id String @id @default(uuid()) @db.Uuid

  patientNumber  String  @unique
  nic            String? @unique
  passportNumber String? @unique
  firstName      String
  middleName     String?
  lastName       String

  dateOfBirth DateTime?
  gender      PatientSex @default(UNKNOWN) @map("sex")

  nationalId String?
  bloodGroup BloodGroup @default(UNKNOWN)
  phone      String?
  email      String?

  registrations  HospitalPatient[]
  addresses      PatientAddress[]
  contacts       PatientContact[]
  medicalHistory PatientMedicalHistory[]
  allergies      PatientAllergy[]
  opdVisits      OPDVisit[]
  ipdAdmissions  IPDAdmission[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  labRequests LabRequest[]

  @@index([nationalId])
  @@index([lastName, firstName])
  @@index([dateOfBirth])
  @@map("patients")
}

model HospitalPatient {
  id String @id @default(uuid()) @db.Uuid

  patientId  String @db.Uuid
  hospitalId String @db.Uuid

  registrationNumber String                    @map("hospitalPatientNumber")
  status             PatientRegistrationStatus @default(ACTIVE) @map("registrationStatus")

  registeredAt DateTime @default(now())

  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, registrationNumber])
  @@unique([patientId, hospitalId])
  @@index([patientId])
  @@index([hospitalId, status])
  @@map("hospital_patients")
}

model PatientAddress {
  id String @id @default(uuid()) @db.Uuid

  patientId String @db.Uuid

  addressLine1 String
  addressLine2 String?
  city         String?
  district     String?
  province     String?
  postalCode   String?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@map("patient_addresses")
}

model PatientContact {
  id String @id @default(uuid()) @db.Uuid

  patientId String @db.Uuid

  name         String?
  relationship String?
  isEmergency  Boolean     @default(false)
  type         ContactType
  value        String
  isPrimary    Boolean     @default(false)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@map("patient_contacts")
}

model PatientMedicalHistory {
  id String @id @default(uuid()) @db.Uuid

  patientId        String  @db.Uuid
  recordedByUserId String? @db.Uuid

  condition   String
  description String?
  diagnosedAt DateTime?
  notes       String?

  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedBy User?   @relation("MedicalHistoryRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@map("patient_medical_history")
}

model PatientAllergy {
  id String @id @default(uuid()) @db.Uuid

  patientId        String  @db.Uuid
  recordedByUserId String? @db.Uuid

  substance String
  reaction  String?
  severity  AllergySeverity @default(UNKNOWN)
  isActive  Boolean         @default(true)
  notes     String?

  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedBy User?   @relation("AllergyRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, isActive])
  @@map("patient_allergies")
}

model OPDVisit {
  id          String @id @default(uuid())
  visitNumber String @unique
  tokenNumber Int

  patientId    String  @db.Uuid
  hospitalId   String  @db.Uuid
  departmentId String  @db.Uuid
  doctorId     String? @db.Uuid

  visitDate DateTime       @default(now())
  status    OPDVisitStatus @default(REGISTERED)

  chiefComplaint String?
  registeredBy   String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient    Patient    @relation(fields: [patientId], references: [id])
  hospital   Hospital   @relation(fields: [hospitalId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  doctor     User?      @relation("OPDDoctor", fields: [doctorId], references: [id])

  consultation   Consultation?
  vitalSigns     VitalSigns[]
  prescriptions  Prescription[]
  investigations InvestigationRequest[]
  user           User?                  @relation(fields: [userId], references: [id])
  userId         String?                @db.Uuid
  labRequests    LabRequest[]

  @@unique([hospitalId, departmentId, visitDate, tokenNumber])
  @@index([hospitalId, departmentId, visitDate, status])
  @@index([patientId])
  @@index([doctorId])
}

model OPDTokenCounter {
  id           String   @id @default(uuid())
  hospitalId   String   @db.Uuid
  departmentId String   @db.Uuid
  visitDay     DateTime @db.Date
  lastToken    Int      @default(0)

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  hospital   Hospital   @relation(fields: [hospitalId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@unique([hospitalId, departmentId, visitDay])
}

model DoctorSchedule {
  id           String @id @default(uuid())
  doctorId     String @db.Uuid
  hospitalId   String @db.Uuid
  departmentId String @db.Uuid

  dayOfWeek   Int
  startTime   String
  endTime     String
  slotMinutes Int    @default(15)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor     User       @relation("DoctorSchedules", fields: [doctorId], references: [id])
  hospital   Hospital   @relation(fields: [hospitalId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  user       User?      @relation("DoctorScheduleUser", fields: [userId], references: [id])
  userId     String?    @db.Uuid

  @@index([doctorId, hospitalId, dayOfWeek])
}

model Consultation {
  id       String @id @default(uuid())
  visitId  String @unique
  doctorId String @db.Uuid

  symptoms      String?
  diagnosis     String?
  clinicalNotes String?
  treatmentPlan String?
  followUpDate  DateTime?

  status ConsultationStatus @default(IN_PROGRESS)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  visit  OPDVisit @relation(fields: [visitId], references: [id])
  doctor User     @relation("ConsultationDoctor", fields: [doctorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation("ConsultationUser", fields: [userId], references: [id])
  userId    String?  @db.Uuid
}

model VitalSigns {
  id      String @id @default(uuid())
  visitId String

  temperature      Float?
  systolicBP       Int?
  diastolicBP      Int?
  pulseRate        Int?
  respiratoryRate  Int?
  oxygenSaturation Float?
  weightKg         Float?
  heightCm         Float?

  recordedBy String?
  recordedAt DateTime @default(now())

  visit OPDVisit @relation(fields: [visitId], references: [id])

  @@index([visitId, recordedAt])
}

model Prescription {
  id       String             @id @default(uuid())
  visitId  String
  doctorId String             @db.Uuid
  status   PrescriptionStatus @default(ACTIVE)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visit  OPDVisit           @relation(fields: [visitId], references: [id])
  doctor User               @relation("PrescriptionDoctor", fields: [doctorId], references: [id])
  items  PrescriptionItem[]
  user   User?              @relation("PrescriptionUser", fields: [userId], references: [id])
  userId String?            @db.Uuid

  @@index([visitId])
}

model PrescriptionItem {
  id             String @id @default(uuid())
  prescriptionId String

  medicineName String
  dosage       String
  frequency    String
  duration     String
  quantity     Int
  instructions String?

  medicineId String?
  medicine   Medicine? @relation(fields: [medicineId], references: [id])

  prescription          Prescription           @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  pharmacyDispenseItems PharmacyDispenseItem[]
}

model InvestigationRequest {
  id       String @id @default(uuid())
  visitId  String
  doctorId String @db.Uuid

  investigationCode String?
  investigationName String
  clinicalReason    String?

  status      InvestigationStatus @default(REQUESTED)
  requestedAt DateTime            @default(now())

  visit  OPDVisit @relation(fields: [visitId], references: [id])
  doctor User     @relation("InvestigationDoctor", fields: [doctorId], references: [id])
  user   User?    @relation("InvestigationRequestUser", fields: [userId], references: [id])
  userId String?  @db.Uuid

  @@index([visitId])
  @@index([status])
}

model IPDAdmission {
  id              String @id @default(uuid())
  admissionNumber String @unique

  patientId    String
  hospitalId   String
  departmentId String

  admittedById      String
  attendingDoctorId String?

  admissionDate DateTime  @default(now())
  dischargeDate DateTime?

  status IPDAdmissionStatus @default(ADMITTED)

  admissionReason    String
  admissionDiagnosis String?
  clinicalNotes      String?

  dischargeSummary      String?
  dischargeInstructions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient    Patient    @relation(fields: [patientId], references: [id])
  hospital   Hospital   @relation(fields: [hospitalId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  admittedBy      User  @relation("IPDAdmittedBy", fields: [admittedById], references: [id])
  attendingDoctor User? @relation("IPDAttendingDoctor", fields: [attendingDoctorId], references: [id])

  bedAllocations IPDBedAllocation[]
  observations   IPDObservation[]
  nursingNotes   IPDNursingNote[]
  labRequests    LabRequest[]

  @@index([hospitalId, status])
  @@index([patientId])
  @@index([departmentId, admissionDate])
  @@index([attendingDoctorId])
}

model IPDBedAllocation {
  id String @id @default(uuid())

  admissionId String
  bedId       String

  allocatedById String
  releasedById  String?

  allocatedAt DateTime  @default(now())
  releasedAt  DateTime?

  admission IPDAdmission @relation(fields: [admissionId], references: [id])
  bed       Bed          @relation(fields: [bedId], references: [id])

  allocatedBy User  @relation("IPDBedAllocatedBy", fields: [allocatedById], references: [id])
  releasedBy  User? @relation("IPDBedReleasedBy", fields: [releasedById], references: [id])

  @@index([admissionId, releasedAt])
  @@index([bedId, releasedAt])
}

model IPDObservation {
  id          String @id @default(uuid())
  admissionId String

  type IPDObservationType @default(ROUTINE)

  temperature      Float?
  systolicBP       Int?
  diastolicBP      Int?
  pulseRate        Int?
  respiratoryRate  Int?
  oxygenSaturation Float?

  weightKg Float?
  notes    String?

  recordedById String
  recordedAt   DateTime @default(now())

  admission  IPDAdmission @relation(fields: [admissionId], references: [id])
  recordedBy User         @relation("IPDObservationRecordedBy", fields: [recordedById], references: [id])

  @@index([admissionId, recordedAt])
}

model IPDNursingNote {
  id          String @id @default(uuid())
  admissionId String

  note         String
  careProvided String?
  recordedById String
  recordedAt   DateTime @default(now())

  admission  IPDAdmission @relation(fields: [admissionId], references: [id])
  recordedBy User         @relation("IPDNursingNoteRecordedBy", fields: [recordedById], references: [id])

  @@index([admissionId, recordedAt])
}

model LabTest {
  id         String @id @default(uuid())
  hospitalId String

  code           String
  name           String
  description    String?
  specimenType   String
  unit           String?
  referenceRange String?
  price          Decimal? @db.Decimal(10, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hospital     Hospital         @relation(fields: [hospitalId], references: [id])
  requestItems LabRequestItem[]

  @@unique([hospitalId, code])
  @@index([hospitalId, isActive])
}

model LabRequest {
  id            String @id @default(uuid())
  requestNumber String @unique

  patientId    String
  hospitalId   String
  departmentId String

  opdVisitId     String?
  ipdAdmissionId String?

  requestedById String

  priority LabPriority      @default(ROUTINE)
  status   LabRequestStatus @default(REQUESTED)

  clinicalNotes String?
  requestedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patient    Patient    @relation(fields: [patientId], references: [id])
  hospital   Hospital   @relation(fields: [hospitalId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  opdVisit     OPDVisit?     @relation(fields: [opdVisitId], references: [id])
  ipdAdmission IPDAdmission? @relation(fields: [ipdAdmissionId], references: [id])

  requestedBy User @relation("LabRequestDoctor", fields: [requestedById], references: [id])

  items  LabRequestItem[]
  user   User?            @relation(fields: [userId], references: [id])
  userId String?          @db.Uuid

  @@index([hospitalId, status, requestedAt])
  @@index([patientId, requestedAt])
  @@index([opdVisitId])
  @@index([ipdAdmissionId])
}

model LabRequestItem {
  id String @id @default(uuid())

  requestId String
  testId    String

  status LabRequestItemStatus @default(REQUESTED)

  sample LabSample?
  result LabResult?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request LabRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  test    LabTest    @relation(fields: [testId], references: [id])

  @@index([requestId, status])
  @@index([testId])
}

model LabSample {
  id           String @id @default(uuid())
  sampleNumber String @unique

  requestItemId String @unique

  specimenType String
  status       LabSampleStatus @default(COLLECTED)

  collectedById String
  collectedAt   DateTime @default(now())

  receivedAt      DateTime?
  rejectionReason String?

  requestItem LabRequestItem @relation(fields: [requestItemId], references: [id])
  collectedBy User           @relation("LabSampleCollectedBy", fields: [collectedById], references: [id])
  user        User?          @relation(fields: [userId], references: [id])
  userId      String?        @db.Uuid

  @@index([status, collectedAt])
}

model LabResult {
  id            String @id @default(uuid())
  requestItemId String @unique

  resultValue    String
  unit           String?
  referenceRange String?
  interpretation String?
  remarks        String?

  status LabResultStatus @default(DRAFT)

  enteredById  String
  verifiedById String?

  enteredAt  DateTime  @default(now())
  verifiedAt DateTime?

  requestItem LabRequestItem @relation(fields: [requestItemId], references: [id])

  enteredBy  User    @relation("LabResultEnteredBy", fields: [enteredById], references: [id])
  verifiedBy User?   @relation("LabResultVerifiedBy", fields: [verifiedById], references: [id])
  user       User?   @relation(fields: [userId], references: [id])
  userId     String? @db.Uuid

  @@index([status, enteredAt])
}

model Medicine {
  id         String @id @default(uuid())
  hospitalId String

  code         String
  name         String
  genericName  String?
  brandName    String?
  strength     String?
  dosageForm   String?
  unit         String
  reorderLevel Int     @default(10)

  status MedicineStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hospital          Hospital               @relation(fields: [hospitalId], references: [id])
  batches           MedicineBatch[]
  purchaseItems     PurchaseOrderItem[]
  dispenseItems     PharmacyDispenseItem[]
  stockMovements    StockMovement[]
  department        Department?            @relation(fields: [departmentId], references: [id])
  departmentId      String?                @db.Uuid
  prescriptionItems PrescriptionItem[]

  @@unique([hospitalId, code])
  @@index([hospitalId, status])
  @@index([hospitalId, name])
}

model Supplier {
  id         String @id @default(uuid())
  hospitalId String

  code          String
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hospital       Hospital        @relation(fields: [hospitalId], references: [id])
  purchaseOrders PurchaseOrder[]
  department     Department?     @relation(fields: [departmentId], references: [id])
  departmentId   String?         @db.Uuid

  @@unique([hospitalId, code])
  @@index([hospitalId, isActive])
}

model PurchaseOrder {
  id          String @id @default(uuid())
  orderNumber String @unique

  hospitalId String
  supplierId String

  status       PurchaseOrderStatus @default(DRAFT)
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  notes        String?

  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hospital  Hospital @relation(fields: [hospitalId], references: [id])
  supplier  Supplier @relation(fields: [supplierId], references: [id])
  createdBy User     @relation("PharmacyPurchaseOrderCreator", fields: [createdById], references: [id])

  items        PurchaseOrderItem[]
  department   Department?         @relation(fields: [departmentId], references: [id])
  departmentId String?             @db.Uuid
  user         User?               @relation(fields: [userId], references: [id])
  userId       String?             @db.Uuid

  @@index([hospitalId, status])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id              String @id @default(uuid())
  purchaseOrderId String
  medicineId      String

  orderedQuantity  Int
  receivedQuantity Int     @default(0)
  unitCost         Decimal @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  medicine      Medicine      @relation(fields: [medicineId], references: [id])

  @@unique([purchaseOrderId, medicineId])
}

model MedicineBatch {
  id         String @id @default(uuid())
  hospitalId String
  medicineId String

  batchNumber String
  expiryDate  DateTime @db.Date

  quantity Int     @default(0)
  unitCost Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medicine       Medicine               @relation(fields: [medicineId], references: [id])
  stockMovements StockMovement[]
  dispenseItems  PharmacyDispenseItem[]
  department     Department?            @relation(fields: [departmentId], references: [id])
  departmentId   String?                @db.Uuid
  hospital       Hospital               @relation(fields: [hospitalId], references: [id])

  @@unique([hospitalId, medicineId, batchNumber])
  @@index([hospitalId, expiryDate])
  @@index([medicineId, expiryDate])
}

model StockMovement {
  id         String  @id @default(uuid())
  hospitalId String
  medicineId String
  batchId    String?

  type         StockMovementType
  quantity     Int
  balanceAfter Int

  reference String?
  reason    String?

  performedById String
  createdAt     DateTime @default(now())

  medicine     Medicine       @relation(fields: [medicineId], references: [id])
  batch        MedicineBatch? @relation(fields: [batchId], references: [id])
  performedBy  User           @relation("PharmacyStockMovementUser", fields: [performedById], references: [id])
  department   Department?    @relation(fields: [departmentId], references: [id])
  departmentId String?        @db.Uuid
  user         User?          @relation(fields: [userId], references: [id])
  userId       String?        @db.Uuid
  hospital     Hospital       @relation(fields: [hospitalId], references: [id])

  @@index([hospitalId, medicineId, createdAt])
  @@index([batchId, createdAt])
}

model PharmacyDispense {
  id             String @id @default(uuid())
  dispenseNumber String @unique

  hospitalId     String
  prescriptionId String

  dispensedById String
  status        PharmacyDispenseStatus @default(COMPLETED)

  notes       String?
  dispensedAt DateTime @default(now())

  items PharmacyDispenseItem[]

  dispensedBy  User        @relation("PharmacyDispenseUser", fields: [dispensedById], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?     @db.Uuid
  user         User?       @relation(fields: [userId], references: [id])
  userId       String?     @db.Uuid
  hospital     Hospital    @relation(fields: [hospitalId], references: [id])

  @@index([hospitalId, dispensedAt])
  @@index([prescriptionId])
}

model PharmacyDispenseItem {
  id                 String @id @default(uuid())
  dispenseId         String
  prescriptionItemId String
  medicineId         String
  batchId            String

  quantity Int

  dispense         PharmacyDispense @relation(fields: [dispenseId], references: [id], onDelete: Cascade)
  prescriptionItem PrescriptionItem @relation(fields: [prescriptionItemId], references: [id])
  medicine         Medicine         @relation(fields: [medicineId], references: [id])
  batch            MedicineBatch    @relation(fields: [batchId], references: [id])

  @@index([prescriptionItemId])
  @@index([batchId])
}

// ======================================================
// 5. SYSTEM ADMINISTRATION & AUDITING
// ======================================================

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  hospitalId  String? @db.Uuid
  actorUserId String? @db.Uuid

  action     AuditAction
  entityType String
  entityId   String?

  oldValues Json?
  newValues Json?

  ipAddress String?
  userAgent String?

  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  actor    User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([hospitalId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model SystemSetting {
  id String @id @default(uuid()) @db.Uuid

  hospitalId      String  @db.Uuid
  updatedByUserId String? @db.Uuid

  key         String
  value       Json
  description String?

  hospital  Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  updatedBy User?    @relation("SettingUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, key])
  @@map("system_settings")
}
