model EmergencyEncounter {
  id           String  @id @default(uuid()) @db.Uuid
  hospitalId   String  @db.Uuid
  departmentId String  @db.Uuid
  patientId    String? @db.Uuid

  encounterNumber  String
  arrivalMode      EmergencyArrivalMode @default(WALK_IN)
  arrivalSource    String?
  referralHospital String?

  // Details used when the patient's identity is not yet known.
  isUnknownPatient     Boolean @default(false)
  temporaryPatientName String?
  temporaryAge         Int?
  temporaryGender      String?
  identifyingNotes     String?

  chiefComplaint String?
  arrivedAt      DateTime @default(now())
  registeredById String   @db.Uuid

  status EmergencyEncounterStatus @default(REGISTERED)

  hospital     Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  patient      Patient?   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  registeredBy User       @relation("EmergencyEncounterRegistrar", fields: [registeredById], references: [id], onDelete: Restrict)

  triages EmergencyTriage[]

  assignedDoctorId String? @db.Uuid
  assignedNurseId  String? @db.Uuid

  assignedDoctor User? @relation("EmergencyAssignedDoctor", fields: [assignedDoctorId], references: [id], onDelete: Restrict)

  assignedNurse User? @relation("EmergencyAssignedNurse", fields: [assignedNurseId], references: [id], onDelete: Restrict)

  calledAt           DateTime?
  treatmentStartedAt DateTime?

  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  user                User?                         @relation(fields: [userId], references: [id])
  userId              String?                       @db.Uuid
  clinicalAssessments EmergencyClinicalAssessment[]
  observations        EmergencyObservation[]
  labRequests         LabRequest[]
  radiologyRequests   RadiologyRequest[]
  prescriptions       Prescription[]                @relation("EmergencyPrescriptions")
  disposition         EmergencyDisposition?

  @@unique([hospitalId, encounterNumber])
  @@index([hospitalId, status, arrivedAt])
  @@index([hospitalId, departmentId, arrivedAt])
  @@index([hospitalId, status, assignedDoctorId])
  @@index([hospitalId, status, assignedNurseId])
  @@index([patientId, arrivedAt])
  @@map("emergency_encounters")
}

model EmergencyTriage {
  id             String                  @id @default(uuid()) @db.Uuid
  encounterId    String                  @db.Uuid
  category       EmergencyTriageCategory
  chiefComplaint String
  symptoms       String?
  triageNotes    String?

  // Initial clinical observations
  temperatureC     Float?
  systolicBP       Int?
  diastolicBP      Int?
  pulseRate        Int?
  respiratoryRate  Int?
  oxygenSaturation Float?
  painScore        Int?

  assessedById String   @db.Uuid
  assessedAt   DateTime @default(now())

  encounter  EmergencyEncounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  assessedBy User               @relation("EmergencyTriageAssessor", fields: [assessedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?  @db.Uuid

  @@index([encounterId, assessedAt])
  @@index([category, assessedAt])
  @@index([assessedById, assessedAt])
  @@map("emergency_triages")
}

model EmergencyClinicalAssessment {
  id           String @id @default(uuid()) @db.Uuid
  hospitalId   String @db.Uuid
  encounterId  String @db.Uuid
  assessedById String @db.Uuid

  assessmentType EmergencyAssessmentType @default(INITIAL)

  presentingComplaint     String
  historyOfPresentIllness String?
  relevantMedicalHistory  String?
  examinationFindings     String?
  provisionalDiagnosis    String
  differentialDiagnosis   String?
  treatmentPlan           String
  clinicalNotes           String?

  assessedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  encounter  EmergencyEncounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  assessedBy User               @relation("EmergencyClinicalAssessor", fields: [assessedById], references: [id], onDelete: Restrict)

  @@index([hospitalId, encounterId, assessedAt])
  @@index([assessedById, assessedAt])
  @@map("emergency_clinical_assessments")
}

model EmergencyObservation {
  id           String @id @default(uuid()) @db.Uuid
  hospitalId   String @db.Uuid
  encounterId  String @db.Uuid
  recordedById String @db.Uuid

  temperatureC       Float?
  systolicBP         Int?
  diastolicBP        Int?
  pulseRate          Int?
  respiratoryRate    Int?
  oxygenSaturation   Float?
  painScore          Int?
  bloodGlucoseMmol   Float?
  consciousnessLevel String?
  notes              String?

  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  encounter  EmergencyEncounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  recordedBy User               @relation("EmergencyObservationRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([hospitalId, encounterId, recordedAt])
  @@index([recordedById, recordedAt])
  @@map("emergency_observations")
}

model EmergencyDisposition {
  id          String @id @default(uuid()) @db.Uuid
  hospitalId  String @db.Uuid
  encounterId String @unique @db.Uuid

  outcome EmergencyDispositionType

  // Link to the existing IPD admission when admitted.
  // IPDAdmission.id is String without @db.Uuid in the existing schema.
  ipdAdmissionId String? @unique

  // Inter-hospital transfer information.
  receivingHospitalName    String?
  receivingHospitalContact String?
  transferReason           String?
  transferNotes            String?

  // Discharge documentation.
  dischargeInstructions String?
  followUpInstructions  String?
  followUpDate          DateTime?

  // Death documentation.
  deathAt            DateTime?
  deathDocumentation String?

  recordedById String   @db.Uuid
  recordedAt   DateTime @default(now())

  encounter    EmergencyEncounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  hospital     Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  recordedBy   User               @relation("EmergencyDispositionRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  ipdAdmission IPDAdmission?      @relation(fields: [ipdAdmissionId], references: [id], onDelete: Restrict)

  @@index([hospitalId, outcome, recordedAt])
  @@index([recordedById, recordedAt])
  @@map("emergency_dispositions")
}

// ======================================================
// 5. SYSTEM ADMINISTRATION & AUDITING
// ======================================================

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  hospitalId  String? @db.Uuid
  actorUserId String? @db.Uuid

  action     AuditAction
  entityType String
  entityId   String?

  oldValues Json?
  newValues Json?

  ipAddress String?
  userAgent String?

  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  actor    User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([hospitalId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model SystemSetting {
  id String @id @default(uuid()) @db.Uuid

  hospitalId      String  @db.Uuid
  updatedByUserId String? @db.Uuid

  key         String
  value       Json
  description String?

  hospital  Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  updatedBy User?    @relation("SettingUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, key])
  @@map("system_settings")
}
